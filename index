<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#08080a">
<title>WebCraft Service · บริการพัฒนาเว็บไซต์</title>
<link href="https://fonts.googleapis.com/css2?family=Anuphan:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4"></script>
<style>
:root{--bg:#08080a;--panel:#121216;--line:#26262d;--red:#ff2d3f;--red2:#b4001b;--ink:#f5f5f6;--mute:#9b9ba6;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:70px;background:var(--bg)}
body{margin:0;font:400 16px/1.7 Anuphan,sans-serif;color:var(--ink);background:var(--bg)}
a{color:inherit}button,input,select,textarea{font:inherit;color:inherit}
.wrap{max-width:1180px;margin:auto;padding:0 20px}
header{position:sticky;top:0;z-index:40;background:rgba(8,8,10,.8);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:14px;height:62px}
.logo{font-weight:700;font-size:20px;text-decoration:none;white-space:nowrap}.logo b{color:var(--red)}
nav{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none}
nav a{padding:6px 14px;border-radius:99px;font-size:14px;color:var(--mute);text-decoration:none;white-space:nowrap}
nav a:hover{color:#fff;background:#1c1c22}
.hero{position:relative;overflow:hidden;text-align:center;padding:clamp(56px,11vw,120px) 0 clamp(44px,8vw,80px);background:radial-gradient(60% 55% at 50% 0,rgba(255,45,63,.32),transparent 70%),linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px) 0 0/48px 48px,linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px) 0 0/48px 48px}
.hero::after{content:"";position:absolute;inset:auto 0 0;height:90px;background:linear-gradient(transparent,var(--bg))}
.hero>*{position:relative;z-index:1}
.pill{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:#14141a;border-radius:99px;padding:5px 16px;font-size:13px;color:var(--mute)}
.pill i,.bd i{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 0 rgba(34,197,94,.7);animation:pu 1.8s infinite}
@keyframes pu{70%{box-shadow:0 0 0 8px transparent}100%{box-shadow:0 0 0 0 transparent}}
h1{margin:18px 0 12px;font-size:clamp(34px,7vw,74px);line-height:1.12;letter-spacing:-.02em}
h1 em{font-style:normal;background:linear-gradient(90deg,#ff6a76,var(--red),var(--red2));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{margin:0 auto 26px;max-width:620px;color:var(--mute);font-size:clamp(15px,2vw,19px)}
.cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.btn{display:inline-block;border:0;cursor:pointer;text-decoration:none;font-weight:600;border-radius:99px;padding:10px 26px;background:linear-gradient(135deg,var(--red),var(--red2));box-shadow:0 10px 30px -10px var(--red);transition:transform .2s}
.btn:hover{transform:translateY(-2px)}
.btn.g{background:transparent;border:1px solid #3a3a44;box-shadow:none}.btn.s{padding:6px 16px;font-size:14px}.btn.d{background:#3a0d12;border:1px solid #6b1620;box-shadow:none;color:#ff8d98}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin:clamp(30px,6vw,56px) auto 0;max-width:820px}
.stats div{background:#101015;border:1px solid var(--line);border-radius:18px;padding:14px 8px}
.stats b{display:block;font-size:clamp(26px,4vw,38px);line-height:1.1;color:var(--red)}.stats span{font-size:13px;color:var(--mute)}
section{padding:clamp(40px,7vw,76px) 0}
.eyebrow{color:var(--red);font-size:13px;font-weight:700;letter-spacing:.14em}
h2{margin:4px 0 6px;font-size:clamp(26px,4.4vw,40px);letter-spacing:-.01em}
.sub{margin:0 0 28px;color:var(--mute)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,270px),1fr));gap:16px}
.card{position:relative;background:linear-gradient(180deg,#16161b,var(--panel));border:1px solid var(--line);border-radius:22px;padding:20px;transition:.25s}
.card:hover{border-color:rgba(255,45,63,.55);box-shadow:0 18px 40px -20px rgba(255,45,63,.55);transform:translateY(-3px)}
.card h3{margin:0 0 4px;font-size:18px}.card small{color:var(--mute);display:block}
.row{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.price{margin-top:12px;font-weight:700;color:#ff6a76}
.bd{display:inline-flex;align-items:center;gap:7px;white-space:nowrap;padding:3px 12px;border-radius:99px;font-size:12px;font-weight:600;background:color-mix(in srgb,var(--c) 16%,transparent);color:var(--c);border:1px solid color-mix(in srgb,var(--c) 40%,transparent)}
.bd i{background:var(--c);animation:none;box-shadow:none}
.bd.ready{--c:#22c55e}.bd.free{--c:#22d3ee}.bd.open{--c:#ff4d5d}.bd.maint{--c:#f59e0b}.bd.ok{--c:#22c55e}.bd.w{--c:#f59e0b}.bd.x{--c:#ff4d5d}
.tag{font-size:12px;font-weight:700;padding:2px 12px;border-radius:99px;background:rgba(255,45,63,.14);color:#ff6a76}.tag.new{background:rgba(34,197,94,.14);color:#4ade80}
.dom{font-family:ui-monospace,monospace;font-size:13px;color:#ff8d98}
.alt{background:#0c0c10;border-block:1px solid var(--line)}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:28px;align-items:start}
.cols h3{margin:0 0 12px;font-size:20px}
details{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:13px 20px;margin-bottom:10px}
details[open]{border-color:rgba(255,45,63,.4)}
summary{cursor:pointer;font-weight:600}
details ul{margin:10px 0 0;padding-left:20px;color:var(--mute)}
.note{padding:12px 18px;border-radius:14px;background:#2a0d11;border:1px solid #6b1620;color:#ffb4bb;margin:16px 0}
footer{border-top:1px solid var(--line);padding:26px 0 34px;text-align:center;color:var(--mute);font-size:14px}
footer a{font-size:11px;opacity:.45;text-decoration:none;margin-left:10px}footer a:hover{opacity:1;color:var(--red)}
/* ผู้ดูแล */
#modal:not(:empty){position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.78);backdrop-filter:blur(6px);display:grid;place-items:center;padding:14px}
.mbox{width:min(980px,100%);max-height:calc(100vh - 28px);overflow:auto;background:#0e0e12;border:1px solid #33333b;border-radius:24px;padding:clamp(18px,3vw,28px);position:relative}
.mbox.sm{width:min(400px,100%)}
.x{position:absolute;top:12px;right:14px;width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:#16161b;cursor:pointer}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin:14px 0 18px}
.tabs button{background:#16161b;border:1px solid var(--line);border-radius:99px;padding:6px 18px;cursor:pointer;font-size:14px}
.tabs button.on{background:var(--red);border-color:var(--red)}
.rf{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:12px;display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}
.rf label{display:block;font-size:12px;color:var(--mute)}.rf label.w{grid-column:1/-1}
input,select,textarea{width:100%;background:#0a0a0d;border:1px solid #30303a;border-radius:12px;padding:8px 12px;margin-top:3px}
input:focus,select:focus,textarea:focus{outline:2px solid var(--red);border-color:transparent}
.acts{grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.hist{grid-column:1/-1;margin:0;padding-left:18px;font-size:13px;color:var(--mute)}
.msg{min-height:22px;color:#ff8d98;font-size:14px}
@media(max-width:560px){.nav{height:auto;padding:8px 20px;flex-direction:column;align-items:stretch;gap:4px}}
</style>
</head>
<body>
<header><div class="wrap nav"><a class="logo" href="#top">Web<b>Craft</b> Service</a><nav><a href="#status">สถานะบริการ</a><a href="#sites">ผลงาน</a><a href="#news">ข่าวสาร</a><a href="#terms">เงื่อนไข</a></nav></div></header>
<main id="app"></main>
<footer><div class="wrap">© <span id="yr"></span> WebCraft Service · บริการออกแบบและพัฒนาเว็บไซต์ครบวงจร<a href="#" id="adl">ผู้ดูแลระบบ</a></div></footer>
<div id="modal"></div>

<script>
/* ===== ตั้งค่าการเชื่อมต่อ Supabase (ใช้โปรเจกต์เดิมของคุณ ตารางใหม่ขึ้นต้นด้วย ws_) ===== */
const SB_URL='https://aefzegkgfwszuiznihsk.supabase.co',SB_KEY='sb_publishable_Z1zogpI9qqUlegxG816ncQ_eHeaiFvr';
const db=window.supabase?supabase.createClient(SB_URL,SB_KEY):null;
const $=s=>document.querySelector(s);
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ST={open:'เปิดให้เช่า',free:'ว่าง',ready:'พร้อมใช้งาน',maint:'ปิดปรับปรุง'};
const OPT={status:ST,type:{promo:'โปรโมชั่น',new:'เว็บไซต์เปิดใหม่'},grp:{terms:'เงื่อนไขบริการ',privacy:'นโยบายความเป็นส่วนตัว'}};
const TABS={
 svc:{l:'บริการ',t:'ws_services',d:{status:'ready'},f:[['name','ชื่อบริการ'],['status','สถานะ','sel'],['note','รายละเอียด'],['price','ราคา']]},
 sites:{l:'เว็บไซต์',t:'ws_sites',d:{status:'ready'},f:[['name','ชื่อเว็บไซต์'],['domain','โดเมน'],['client','ลูกค้า'],['status','สถานะ','sel']]},
 news:{l:'ข่าวสาร',t:'ws_news',d:{type:'promo'},f:[['type','ประเภท','sel'],['title','หัวข้อ'],['body','รายละเอียด','area']]},
 ctr:{l:'สัญญา',t:'ws_contracts',d:{},f:[['client','ลูกค้า'],['site','โดเมน'],['end_date','วันหมดอายุ','date']]},
 terms:{l:'เงื่อนไข / นโยบาย',t:'ws_terms',d:{grp:'terms',sort:99},f:[['grp','หมวด','sel'],['title','หัวข้อ'],['sort','ลำดับ','number'],['items','รายการ (หนึ่งบรรทัดต่อหนึ่งข้อ)','area']]}
};
const D={svc:[],sites:[],news:[],ctr:[],ren:[],terms:[],notice:30,err:''};
let stamp=new Date(),tab='svc',session=null;
const iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,0)+'-'+String(d.getDate()).padStart(2,0);
const left=s=>Math.round((new Date(s+'T00:00:00')-new Date(new Date().toDateString()))/864e5);
const fd=s=>new Date(String(s).slice(0,10)+'T00:00:00').toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'numeric'});
const bd=k=>`<span class="bd ${k}"><i></i>${ST[k]||k}</span>`;
function cst(c){const l=left(c.end_date);return l<0?['x',`หมดอายุแล้ว ${-l} วัน`]:l<=D.notice?['w',`ใกล้หมดอายุ เหลือ ${l} วัน`]:['ok',`ปกติ เหลืออีก ${l} วัน`];}

async function load(){
 if(!db){D.err='โหลดไลบรารีฐานข้อมูลไม่สำเร็จ (ตรวจสอบอินเทอร์เน็ต)';return render();}
 const q=(t,o='id',a=true)=>db.from(t).select('*').order(o,{ascending:a});
 const r=await Promise.all([q('ws_services'),q('ws_sites'),q('ws_news','published_at',false),q('ws_terms','sort'),q('ws_contracts','end_date'),q('ws_renewals','id',false),db.from('ws_settings').select('*')]);
 const bad=r.find(x=>x.error);
 if(bad){D.err='เชื่อมต่อฐานข้อมูลไม่สำเร็จ: '+bad.error.message+' — ตรวจสอบว่ารัน setup.sql แล้ว';return render();}
 [D.svc,D.sites,D.news,D.terms,D.ctr,D.ren]=r.slice(0,6).map(x=>x.data);
 D.notice=+(r[6].data.find(x=>x.key==='notice_days')||{}).value||30;
 D.err='';stamp=new Date();render();
}
function render(){
 const c=k=>D.svc.filter(x=>x.status===k).length;
 const list=g=>D.terms.filter(x=>x.grp===g).map((t,i)=>`<details${i?'':' open'}><summary>${esc(t.title)}</summary><ul>${String(t.items||'').split('\n').filter(Boolean).map(x=>`<li>${esc(x)}</li>`).join('')}</ul></details>`).join('');
 $('#app').innerHTML=`<div id="top"></div>
 <div class="hero"><div class="wrap"><span class="pill"><i></i>ระบบออนไลน์ · ซิงก์ล่าสุด <b id="clk"></b></span>
 <h1>เว็บไซต์ที่ <em>โดดเด่น</em><br>ดูแลให้ต่อเนื่อง</h1>
 <p>ออกแบบ พัฒนา และดูแลเว็บไซต์ครบวงจร พร้อมสัญญาที่โปร่งใส ตรวจสอบสถานะบริการได้ทุกเวลา</p>
 <div class="cta"><a class="btn" href="#status">ดูสถานะบริการ</a><a class="btn g" href="#terms">เงื่อนไขบริการ</a></div>
 <div class="stats">${Object.keys(ST).map(k=>`<div><b>${c(k)}</b><span>${ST[k]}</span></div>`).join('')}<div><b>${D.sites.length}</b><span>เว็บไซต์ที่ดูแล</span></div></div></div></div>
 ${D.err?`<div class="wrap"><div class="note">${esc(D.err)}</div></div>`:''}
 <section id="status"><div class="wrap"><div class="eyebrow">LIVE STATUS</div><h2>สถานะบริการแบบเรียลไทม์</h2><p class="sub">เปิดให้เช่า ว่าง พร้อมใช้งาน หรือปิดปรับปรุง — อัปเดตทันทีที่ทีมงานเปลี่ยนสถานะ</p>
 <div class="grid">${D.svc.map(s=>`<div class="card"><div class="row"><h3>${esc(s.name)}</h3>${bd(s.status)}</div><small>${esc(s.note)}</small><div class="price">${esc(s.price)}</div></div>`).join('')}</div></div></section>
 <section id="sites" class="alt"><div class="wrap"><div class="eyebrow">PORTFOLIO</div><h2>เว็บไซต์ที่กำลังให้บริการ</h2><p class="sub">ผลงานที่เราดูแลอยู่ในปัจจุบัน ${D.sites.length} เว็บไซต์</p>
 <div class="grid">${D.sites.map(s=>`<div class="card"><div class="row"><h3>${esc(s.name)}</h3>${bd(s.status)}</div><span class="dom">${esc(s.domain)}</span><small style="margin-top:8px">ลูกค้า: ${esc(s.client)}</small></div>`).join('')}</div></div></section>
 <section id="news"><div class="wrap"><div class="eyebrow">NEWS</div><h2>ประกาศข่าวสาร</h2><p class="sub">โปรโมชั่นและเว็บไซต์เปิดใหม่ล่าสุด</p>
 <div class="grid">${D.news.map(n=>`<article class="card"><div class="row"><span class="tag ${n.type==='new'?'new':''}">${OPT.type[n.type]||''}</span><small>${fd(n.published_at)}</small></div><h3 style="margin:10px 0 6px">${esc(n.title)}</h3><small>${esc(n.body)}</small></article>`).join('')}</div></div></section>
 <section id="terms" class="alt"><div class="wrap"><div class="eyebrow">POLICY</div><h2>เงื่อนไขและความเป็นส่วนตัว</h2><p class="sub">โปร่งใสทุกขั้นตอน ทั้งสิทธิ์การใช้งาน การคืนเงิน การดูแลระบบ และสิ่งที่ลูกค้าจะได้รับ</p>
 <div class="cols"><div><h3>เงื่อนไขการให้บริการ</h3>${list('terms')}</div><div><h3>นโยบายความเป็นส่วนตัว</h3>${list('privacy')}</div></div></div></section>`;
 tick();
}
const tick=()=>{const c=$('#clk');if(c)c.textContent=stamp.toLocaleTimeString('th-TH');};

/* ===== ส่วนผู้ดูแล (เปิดจากลิงก์เล็กๆ ท้ายหน้า) ===== */
const modal=h=>{$('#modal').innerHTML=h;};
const close=()=>modal('');
function loginUI(m=''){modal(`<div class="mbox sm"><button class="x" data-a="close" aria-label="ปิด">✕</button><h2 style="font-size:24px">เข้าสู่ระบบผู้ดูแล</h2><div class="rf" style="border:0;padding:0;background:none;grid-template-columns:1fr"><label>อีเมล<input id="em" type="email" autocomplete="username"></label><label>รหัสผ่าน<input id="pw" type="password" autocomplete="current-password"></label></div><div class="msg" id="lm">${m}</div><button class="btn" data-a="login" style="width:100%">เข้าสู่ระบบ</button></div>`);$('#em').focus();}
const fld=([k,l,ty],v)=>{const i=ty==='sel'?`<select data-f="${k}">${Object.entries(OPT[k]).map(([a,b])=>`<option value="${a}"${a==v?' selected':''}>${b}</option>`).join('')}</select>`:ty==='area'?`<textarea data-f="${k}" rows="4">${esc(v)}</textarea>`:`<input data-f="${k}" type="${ty||'text'}" value="${esc(v)}">`;return `<label class="${ty==='area'?'w':''}">${l}${i}</label>`;};
function rf(r,T,extra=''){return `<div class="rf" data-id="${r.id||''}">${T.f.map(f=>fld(f,r[f[0]]??'')).join('')}<div class="acts"><button class="btn s" data-a="save">${r.id?'บันทึก':'+ เพิ่ม'}</button>${r.id?'<button class="btn s d" data-a="del">ลบ</button>':''}${extra}</div></div>`;}
function adm(){
 const T=TABS[tab],keep=$('.mbox')?.scrollTop||0;
 const due=D.ctr.filter(c=>left(c.end_date)<=D.notice).length;
 let body=`<details style="margin-bottom:14px"><summary>+ เพิ่มรายการใหม่</summary><div style="margin-top:12px">${rf({...T.d},T)}</div></details>`;
 if(tab==='ctr')body=`<div class="rf" style="grid-template-columns:1fr auto;align-items:end"><div>${due?`<b style="color:#ffb4bb">🔔 ${due} สัญญาใกล้หมดอายุ/หมดอายุแล้ว</b>`:'<b style="color:#4ade80">ไม่มีสัญญาใกล้หมดอายุ</b>'}</div><label>แจ้งเตือนล่วงหน้า<select id="nd">${[7,15,30,60].map(d=>`<option value="${d}"${d===D.notice?' selected':''}>${d} วัน</option>`).join('')}</select></label></div>`+body;
 body+=D[tab].map(r=>{let ex='';
  if(tab==='ctr'){const [k,t]=cst(r),h=D.ren.filter(x=>x.contract_id===r.id);
   ex=`<span class="bd ${k}"><i></i>${t}</span><select class="rm" style="width:auto"><option value="1">1 เดือน</option><option value="3">3 เดือน</option><option value="6">6 เดือน</option><option value="12" selected>12 เดือน</option></select><button class="btn s" data-a="renew">ต่ออายุ</button></div>${h.length?`<ul class="hist">${h.map(x=>`<li>${fd(x.renewed_at)}: ต่อ ${x.months} เดือน (${fd(x.from_date)} → ${fd(x.to_date)})</li>`).join('')}</ul>`:'<p class="hist" style="list-style:none;padding:0">ยังไม่มีประวัติการต่ออายุ</p>'}<div hidden>`;}
  return rf(r,T,ex);}).join('');
 modal(`<div class="mbox"><button class="x" data-a="close" aria-label="ปิด">✕</button><h2 style="font-size:26px">จัดการระบบ</h2><div class="tabs">${Object.entries(TABS).map(([k,v])=>`<button data-a="tab" data-k="${k}" class="${k===tab?'on':''}">${v.l}</button>`).join('')}<button data-a="out" style="margin-left:auto">ออกจากระบบ</button></div><div class="msg" id="am"></div>${body}</div>`);
 $('.mbox').scrollTop=keep;
}
async function openAdmin(){if(!db)return;const {data}=await db.auth.getSession();session=data.session;session?adm():loginUI();}
const msg=t=>{const m=$('#am');if(m)m.textContent=t;};
document.addEventListener('click',async ev=>{
 if(ev.target.id==='adl'){ev.preventDefault();return openAdmin();}
 if(ev.target.id==='modal')return close();
 const b=ev.target.closest('[data-a]');if(!b)return;const a=b.dataset.a,f=b.closest('.rf');
 if(a==='close')close();
 else if(a==='tab'){tab=b.dataset.k;adm();}
 else if(a==='login'){const {error}=await db.auth.signInWithPassword({email:$('#em').value.trim(),password:$('#pw').value});if(error)return loginUI('เข้าสู่ระบบไม่สำเร็จ: '+esc(error.message));await load();adm();}
 else if(a==='out'){await db.auth.signOut();close();load();}
 else{const T=TABS[tab],id=f.dataset.id;let res;
  if(a==='save'){const o={};f.querySelectorAll('[data-f]').forEach(i=>{o[i.dataset.f]=i.type==='number'?+i.value||0:(i.value===''&&i.type==='date'?null:i.value);});
   if(T.t==='ws_contracts'&&!o.end_date)return msg('กรุณาระบุวันหมดอายุ');
   res=id?await db.from(T.t).update(o).eq('id',id):await db.from(T.t).insert(o);}
  else if(a==='del'){if(!b.dataset.sure){b.dataset.sure=1;b.textContent='กดอีกครั้งเพื่อยืนยันลบ';return;}res=await db.from(T.t).delete().eq('id',id);}
  else if(a==='renew')res=await db.rpc('ws_renew',{cid:+id,m:+f.querySelector('.rm').value});
  if(res&&res.error)return msg('ผิดพลาด: '+res.error.message);
  await load();adm();msg('บันทึกเรียบร้อย ✓');}
});
document.addEventListener('change',async ev=>{if(ev.target.id==='nd'){const {error}=await db.from('ws_settings').upsert({key:'notice_days',value:ev.target.value});if(error)return msg(error.message);await load();adm();}});
addEventListener('keydown',ev=>{if(ev.key==='Escape')close();if(ev.key==='Enter'&&ev.target.id==='pw')document.querySelector('[data-a=login]').click();});
$('#yr').textContent=new Date().getFullYear()+543;
render();load();setInterval(tick,1000);setInterval(()=>{if(!$('#modal').firstChild)load();},20000);
if(db)db.channel('ws').on('postgres_changes',{event:'*',schema:'public'},()=>{if(!$('#modal').firstChild)load();}).subscribe();
</script>
